{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/features/*": [
        "./src/features/*"
      ],
      "@trade-bot/api/*": [
        "../api/src/*"
      ],
      "@trade-bot/db": [
        "../../packages/db/src/index.ts"
      ],
      "@trade-bot/db/*": [
        "../../packages/db/src/*"
      ],
      "@trade-bot/utils": [
        "../../packages/utils/src/index.ts"
      ],
      "@trade-bot/utils/*": [
        "../../packages/utils/src/*"
      ],
      "@trade-bot/redis": [
        "../../packages/redis/src/index.ts"
      ],
      "@trade-bot/redis/*": [
        "../../packages/redis/src/*"
      ],
      "@trade-bot/logger": [
        "../../packages/logger/src/index.ts"
      ],
      "@trade-bot/logger/*": [
        "../../packages/logger/src/*"
      ],
      "@trade-bot/types": [
        "../../packages/types/src/index.ts"
      ],
      "@trade-bot/types/*": [
        "../../packages/types/src/*"
      ],
      "@trade-bot/alpaca": [
        "../../packages/alpaca/src/index.ts"
      ],
      "@trade-bot/alpaca/*": [
        "../../packages/alpaca/src/*"
      ],
      "@trade-bot/hyperliquid": [
        "../../packages/hyperliquid/src/index.ts"
      ],
      "@trade-bot/hyperliquid/*": [
        "../../packages/hyperliquid/src/*"
      ]
    }
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "./.next/types/**/*.ts",
    "./next-env.d.ts",
    ".next/types/**/*.ts",
    "src/components/ui/GridBackground",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "./node_modules",
    "./public/charting_library",
    "./public/datafeeds"
  ]
}
