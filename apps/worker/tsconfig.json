{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@worker/*": ["./src/*"],
      "@trade-bot/db": ["../../packages/db/src/index.ts"],
      "@trade-bot/db/*": ["../../packages/db/src/*"],
      "@trade-bot/utils": ["../../packages/utils/src/index.ts"],
      "@trade-bot/utils/*": ["../../packages/utils/src/*"],
      "@trade-bot/redis": ["../../packages/redis/src/index.ts"],
      "@trade-bot/redis/*": ["../../packages/redis/src/*"],
      "@trade-bot/logger": ["../../packages/logger/src/index.ts"],
      "@trade-bot/logger/*": ["../../packages/logger/src/*"],
      "@trade-bot/types": ["../../packages/types/src/index.ts"],
      "@trade-bot/types/*": ["../../packages/types/src/*"],
      "@trade-bot/alpaca": ["../../packages/alpaca/src/index.ts"],
      "@trade-bot/alpaca/*": ["../../packages/alpaca/src/*"],
      "@trade-bot/hyperliquid": ["../../packages/hyperliquid/src/index.ts"],
      "@trade-bot/hyperliquid/*": ["../../packages/hyperliquid/src/*"],
      "@trade-bot/pnl-image": ["../../packages/pnl-image/src/index.ts"],
      "@trade-bot/pnl-image/*": ["../../packages/pnl-image/src/*"]
    },
    "skipLibCheck": true,
    "strictNullChecks": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "old"]
}
