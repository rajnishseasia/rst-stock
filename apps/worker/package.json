{
  "name": "@trade-bot/worker",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "bunx tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check-types": "bun run typecheck",
    "dev": "bun run --hot src/index.ts",
