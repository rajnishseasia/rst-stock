    "@trade-bot/logger": "workspace:*",
    "@trade-bot/pnl-image": "workspace:*",
    "@trade-bot/redis": "workspace:*",
    "@trade-bot/types": "workspace:*",
    "@trade-bot/utils": "workspace:*",
    "axios": "^1.7.2",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.31.2",
    "hono": "^4.9.6",
    "ioredis": "^5.4.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "^1.2.21",
