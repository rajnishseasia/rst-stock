{
  "name": "trade-bot",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "bun test --timeout 30000",
    "dev:web": "turbo -F @trade-bot/web dev",
    "dev:api": "turbo -F @trade-bot/api dev",
    "dev:worker": "turbo -F @trade-bot/worker dev",
    "db:generate": "bun --filter @trade-bot/db db:generate",
    "db:validate": "bun --filter @trade-bot/db db:validate",
    "db:push": "bun --filter @trade-bot/db db:push",
    "db:migrate": "bun --filter @trade-bot/db db:migrate",
    "db:migrate:production": "bun --filter @trade-bot/db db:migrate:production",
    "db:verify-worker-schema": "bun --filter @trade-bot/db db:verify-worker-schema",
    "db:studio": "bun --filter @trade-bot/db db:studio"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "oxlint": "^1.0.0",
    "turbo": "^2.0.4"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.3.4",
  "overrides": {
    "drizzle-orm": "0.31.4"
  }
}
